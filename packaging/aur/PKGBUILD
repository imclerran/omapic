# Maintainer: Ian McLerran <imclerran@protonmail.com>
pkgname=omapic
pkgver=0.4.0
pkgrel=1
pkgdesc="A photo gallery with tagging, tag filtering, and slideshows"
arch=('x86_64')
url="https://github.com/imclerran/omapic"
license=('GPL-3.0-or-later')
# kimageformats ships the Qt 6 HEIC/HEIF and AVIF image plugins, which load
# libheif and libavif respectively, so .heic/.heif/.avif photos display out of
# the box.
depends=('qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-wayland'
         'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'exiv2' 'ffmpegthumbnailer' 'dbus'
         'kimageformats' 'libheif' 'libavif')
optdepends=('aether: generate and edit Omarchy themes from a photo')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DOMAPIC_BUILD_TESTS=OFF \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
